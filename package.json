{
  "name": "caret",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:browser:vitest": "vitest run --config vitest.browser.config.ts",
    "test:browser": "playwright test",
    "capture:readme": "playwright test playground/tests/readme-screenshots.spec.ts",
    "dev": "vite --config playground/vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.4"
  }
}
